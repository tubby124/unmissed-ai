# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
CRON_SECRET=replace-with-local-secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Ultravox
ULTRAVOX_API_KEY=replace-with-ultravox-key

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-token
TWILIO_FROM_NUMBER=+15555550100

# Stripe
# Use test keys locally. Live keys are blocked outside production unless
# ALLOW_LIVE_STRIPE_LOCAL=true is set intentionally for a one-off operator task.
STRIPE_SECRET_KEY=sk_test_replace
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
ALLOW_LIVE_STRIPE_LOCAL=false

# Public checkout prices
STRIPE_SETUP_PRICE_ID=price_replace_setup
STRIPE_CORE_MONTHLY_PRICE_ID=price_replace_core_monthly
STRIPE_PRO_MONTHLY_PRICE_ID=price_replace_pro_monthly
STRIPE_GROWTH_MONTHLY_PRICE_ID=price_replace_growth_monthly

# Optional integrations
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEBHOOK_SIGNING_SECRET=
ULTRAVOX_WEBHOOK_SECRET=
# External speed-to-lead integration (hasansharif.ca Phase 1)
EXTERNAL_LEAD_CALL_API_KEY=
LEAD_WEBHOOK_SECRET=
